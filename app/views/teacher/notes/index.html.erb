<h1 class="text-2xl font-bold mb-4">Notes for <%= @course.name %></h1>

<%= link_to "New Note", new_teacher_course_note_path(@course), class: "bg-blue-600 text-white px-4 py-2 rounded mb-4 inline-block" %>

<ul class="mt-4 space-y-3">
  <% @notes.each do |note| %>
    <li class="border p-3 rounded">
      <strong><%= note.title %></strong>
      <p><%= note.content %></p>

          <div class="flex space-x-3 mt-2">
        <%= link_to "Edit", edit_teacher_course_note_path(@course, note), class: "text-yellow-600 hover:underline" %>
        <%= link_to "Delete", teacher_course_note_path(@course, note),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "text-red-600 hover:underline" %>
      </div>

      <% if note.attachments.attached? %>
        <p class="mt-2 font-semibold"> Attachments:</p>
        <ul>
          <% note.attachments.each do |file| %>
            <li>
              <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment"), class: "text-blue-600 hover:underline" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </li>
  <% end %>
  
</ul>
