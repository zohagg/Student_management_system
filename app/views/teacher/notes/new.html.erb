<h1 class="text-2xl font-bold mb-4">New Note for <%= @course.name %></h1>

<%= form_with(model: [:teacher, @course, @note], local: true, html: { multipart: true }) do |form| %>
  <div class="mb-4">
    <%= form.label :title, class: "block text-gray-700 font-semibold mb-2" %>
    <%= form.text_field :title, class: "border rounded w-full p-2" %>
  </div>

  <div class="mb-4">
    <%= form.label :content, class: "block text-gray-700 font-semibold mb-2" %>
    <%= form.text_area :content, rows: 5, class: "border rounded w-full p-2" %>
  </div>

  <div class="mb-4">
    <%= form.label :attachments, "Upload Files", class: "block text-gray-700 font-semibold mb-2" %>
    <%= form.file_field :attachments, multiple: true, class: "border rounded w-full p-2" %>
  </div>

  <%= form.submit "Create Note", class: "text-blue-600 hover:underline mt-4 inline-block" %>
<% end %>

<%= link_to "Back to Notes", teacher_course_notes_path(@course), class: "text-blue-600 hover:underline mt-4 inline-block" %>
