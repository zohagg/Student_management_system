<div class="p-6">
  <h1 class="text-2xl font-bold text-gray-800 mb-4">Edit Note</h1>

  <%= form_with model: [:teacher, @course, @note], local: true do |f| %>
    <div class="mb-4">
      <%= f.label :title, class: "block font-semibold mb-1" %>
      <%= f.text_field :title, class: "w-full border p-2 rounded" %>
    </div>

    <div class="mb-4">
      <%= f.label :content, class: "block font-semibold mb-1" %>
      <%= f.text_area :content, rows: 5, class: "w-full border p-2 rounded" %>
    </div>

    <div class="flex space-x-4">
      <%= f.submit "Update Note", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
      <%= link_to "Back", [:teacher, @course, @note], class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
</div>
