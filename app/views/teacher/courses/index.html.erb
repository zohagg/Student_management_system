<h1 class="text-2xl font-bold mb-4">My Courses</h1>

<div class="mb-4">
  <%= link_to "New Course", new_teacher_course_path, class: "bg-blue-600 text-white px-4 py-2 rounded" %>
</div>

<ul class="space-y-2">
  <% @courses.each do |course| %>
    <li class="p-4 bg-white rounded shadow">
      <h2 class="font-semibold text-blue-600 hover:underline">
        <%= link_to course.name, teacher_course_path(course) %>
      </h2>
      <p><%= course.description %></p>
    </li>
  <% end %>
</ul>
